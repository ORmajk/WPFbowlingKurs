<Page x:Class="WPFbowlingKurs.AppData.Pages.AiPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:WPFbowlingKurs.AppData.Pages"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="1000"
      Title="AiPage" IsVisibleChanged="Page_IsVisibleChanged">

    <Page.Resources>
        <Style x:Key="AnswerBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource BackColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource HeaderColor}">
            <TextBlock Text="AI-помощник" FontSize="22" Margin="30,0,0,0" Foreground="#FF4E5E38"/>
            <Button x:Name="btnBack" Content="Назад" Style="{StaticResource BtnMain}" Width="100" HorizontalAlignment="Right"
                    Margin="0,0,20,0" Click="btnBack_Click"/>
        </Grid>

        <Border x:Name="brdNoAi" Grid.Row="1" Background="{StaticResource TextColor}" CornerRadius="10" Width="520" Height="220"
                HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="AI-помощник не подключён" FontSize="20" HorizontalAlignment="Center"/>
                <TextBlock x:Name="tbNoAi" TextWrapping="Wrap" Margin="0,15" HorizontalAlignment="Center" TextAlignment="Center"/>
                <Button x:Name="btnSubscribe" Content="Подключить за 100 баллов" Style="{StaticResource BtnMain}" Width="280"
                        Click="btnSubscribe_Click"/>
            </StackPanel>
        </Border>

        <TabControl x:Name="tcAi" Grid.Row="1" Margin="15,10" FontFamily="Verdana" FontSize="14">
            <TabItem x:Name="tiLoad" Header="Загруженность">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Button x:Name="btnLoad" Content="Проанализировать загруженность" Style="{StaticResource BtnMain}" Width="330"
                            HorizontalAlignment="Left" Click="btnLoad_Click"/>
                    <TextBox x:Name="tbLoad" Grid.Row="1" Style="{StaticResource AnswerBox}"/>
                </Grid>
            </TabItem>

            <TabItem x:Name="tiForecast" Header="Прогноз">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Button x:Name="btnForecast" Content="Прогноз на неделю" Style="{StaticResource BtnMain}" Width="220"
                            HorizontalAlignment="Left" Click="btnForecast_Click"/>
                    <TextBox x:Name="tbForecast" Grid.Row="1" Style="{StaticResource AnswerBox}"/>
                </Grid>
            </TabItem>

            <TabItem x:Name="tiAdvice" Header="Рекомендации">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Button x:Name="btnAdvice" Content="Советы по расписанию" Style="{StaticResource BtnMain}" Width="250"
                            HorizontalAlignment="Left" Click="btnAdvice_Click"/>
                    <TextBox x:Name="tbAdvice" Grid.Row="1" Style="{StaticResource AnswerBox}"/>
                </Grid>
            </TabItem>

            <TabItem x:Name="tiFree" Header="Когда прийти">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <WrapPanel>
                        <TextBlock Text="Дата:" Margin="5"/>
                        <DatePicker x:Name="dpFreeDate" Width="150"/>
                        <Button x:Name="btnFree" Content="Показать свободное время" Style="{StaticResource BtnMain}" Width="270"
                                Click="btnFree_Click"/>
                    </WrapPanel>
                    <TextBox x:Name="tbFree" Grid.Row="1" Style="{StaticResource AnswerBox}"/>
                </Grid>
            </TabItem>

            <TabItem x:Name="tiInventory" Header="Подбор инвентаря">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <WrapPanel>
                        <TextBlock Text="Вес (кг):" Margin="5"/>
                        <TextBox x:Name="tbWeight" Width="70"/>
                        <TextBlock Text="Возраст:" Margin="5"/>
                        <TextBox x:Name="tbAge" Width="70"/>
                        <TextBlock Text="Размер обуви:" Margin="5"/>
                        <TextBox x:Name="tbShoe" Width="70"/>
                        <Button x:Name="btnPick" Content="Подобрать" Style="{StaticResource BtnMain}" Width="140" Click="btnPick_Click"/>
                    </WrapPanel>
                    <TextBox x:Name="tbPick" Grid.Row="1" Style="{StaticResource AnswerBox}"/>
                </Grid>
            </TabItem>

            <TabItem x:Name="tiEvent" Header="Описание мероприятия">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <WrapPanel>
                        <TextBlock Text="Мероприятие:" Margin="5"/>
                        <ComboBox x:Name="cbEvent" Width="300" DisplayMemberPath="Name"/>
                        <Button x:Name="btnDescribe" Content="Сгенерировать" Style="{StaticResource BtnMain}" Width="170" Click="btnDescribe_Click"/>
                        <Button x:Name="btnApply" Content="Сохранить в мероприятие" Style="{StaticResource BtnMain}" Width="260" Click="btnApply_Click"/>
                    </WrapPanel>
                    <TextBox x:Name="tbDescribe" Grid.Row="1" Style="{StaticResource AnswerBox}" IsReadOnly="False"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
