<Page x:Class="WPFbowlingKurs.AppData.Pages.ClientEventsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:WPFbowlingKurs.AppData.Pages"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="1000"
      Title="ClientEventsPage" IsVisibleChanged="Page_IsVisibleChanged">

    <Grid Background="{StaticResource BackColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource HeaderColor}">
            <TextBlock Text="Мероприятия клуба" FontSize="22" Margin="30,0,0,0" Foreground="#FF4E5E38"/>
            <Button x:Name="btnBack" Content="Назад" Style="{StaticResource BtnMain}" Width="100" HorizontalAlignment="Right"
                    Margin="0,0,20,0" Click="btnBack_Click"/>
        </Grid>

        <WrapPanel Grid.Row="1" Margin="10,5">
            <CheckBox x:Name="chbAll" Content="Показать прошедшие" Checked="chbAll_Changed" Unchecked="chbAll_Changed"/>
            <TextBlock Text="За запись на мероприятие начисляется 5 баллов и награда «Участник мероприятий»." Margin="20,5" FontSize="13"/>
        </WrapPanel>

        <ListView x:Name="lvEvents" Grid.Row="2" Margin="15,5" Background="Transparent" BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Width="300" Height="220" Background="White" BorderBrush="{StaticResource HeaderColor}" BorderThickness="2"
                            CornerRadius="8" Padding="10" Margin="3">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="#FF4E5E38" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding EventDate, StringFormat='Дата: {0:dd.MM.yyyy}'}" FontSize="13" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding LaneText}" FontSize="13"/>
                            <TextBlock Text="{Binding MembersText}" FontSize="13"/>
                            <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap" Height="75" Margin="0,4"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding MyStatus}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource ButtonColor}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="15,0,15,10">
            <Button x:Name="btnJoin" Content="Записаться" Style="{StaticResource BtnMain}" Width="150" Click="btnJoin_Click"/>
            <Button x:Name="btnLeave" Content="Отменить запись" Style="{StaticResource BtnMain}" Width="180"
                    Background="#FFB24A3E" Click="btnLeave_Click"/>
        </StackPanel>
    </Grid>
</Page>
