<Page x:Class="WPFbowlingKurs.AppData.Pages.ProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPFbowlingKurs.AppData.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1000"
      Title="ProductsPage">

    <Grid Background="{StaticResource BackColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource HeaderColor}">
            <TextBlock Text="Бар и магазин" FontSize="22" Margin="30,0,0,0" Foreground="#FF4E5E38"/>
            <Button x:Name="btnBack" Content="Назад" Style="{StaticResource BtnMain}" Width="100" HorizontalAlignment="Right"
                    Margin="0,0,20,0" Click="btnBack_Click"/>
        </Grid>

        <WrapPanel Grid.Row="1" Margin="10,5">
            <TextBlock Text="Поиск:" Margin="5"/>
            <TextBox x:Name="tbSearch" Width="200" TextChanged="tbSearch_TextChanged"/>
            <TextBlock Text="Категория:" Margin="10,5,5,5"/>
            <ComboBox x:Name="cbCategory" Width="170" SelectionChanged="cbCategory_SelectionChanged"/>
            <TextBlock Text="Сортировка:" Margin="10,5,5,5"/>
            <ComboBox x:Name="cbSort" Width="200" SelectionChanged="cbSort_SelectionChanged">
                <ComboBoxItem Content="По категориям"/>
                <ComboBoxItem Content="Сначала дешевле"/>
                <ComboBoxItem Content="Сначала дороже"/>
                <ComboBoxItem Content="Меньше всего на складе"/>
            </ComboBox>
        </WrapPanel>

        <ListView x:Name="lvProducts" Grid.Row="2" Margin="15,5" Background="Transparent" BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Width="210" Background="White" BorderBrush="{StaticResource HeaderColor}" BorderThickness="2"
                            CornerRadius="8" Padding="8" Margin="3">
                        <StackPanel>
                            <Border Height="120" CornerRadius="5" ClipToBounds="True">
                                <Image Source="{Binding PhotoPath}" Stretch="UniformToFill"/>
                            </Border>
                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" Foreground="#FF4E5E38"
                                       TextWrapping="Wrap" Margin="0,6,0,2"/>
                            <TextBlock Text="{Binding Category}" FontSize="12" Foreground="Gray"/>
                            <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap" Height="34" Margin="0,2"/>
                            <TextBlock Text="{Binding Price, StringFormat='{}{0:N0} руб.'}" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource ButtonColor}"/>
                            <TextBlock Text="{Binding StockText}" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="3" Margin="15,0,15,10">
            <TextBlock Text="Товары добавляет и редактирует менеджер на сайте клуба" Foreground="Gray" FontSize="12"/>
            <TextBlock x:Name="tbCount" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Page>
