<Page x:Class="WPFbowlingKurs.AppData.Pages.EventsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:WPFbowlingKurs.AppData.Pages"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="1000"
      Title="EventsPage" IsVisibleChanged="Page_IsVisibleChanged">

    <Grid Background="{StaticResource BackColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource HeaderColor}">
            <TextBlock Text="Мероприятия" FontSize="22" Margin="30,0,0,0" Foreground="#FF4E5E38"/>
            <Button x:Name="btnBack" Content="Назад" Style="{StaticResource BtnMain}" Width="100" HorizontalAlignment="Right"
                    Margin="0,0,20,0" Click="btnBack_Click"/>
        </Grid>

        <WrapPanel Grid.Row="1" Margin="10,5">
            <TextBlock Text="Поиск по названию:" Margin="5"/>
            <TextBox x:Name="tbSearch" Width="220" TextChanged="tbSearch_TextChanged"/>
            <CheckBox x:Name="chbFuture" Content="Только предстоящие" Margin="15,5,5,5" Checked="chbFuture_Changed" Unchecked="chbFuture_Changed"/>
        </WrapPanel>

        <DataGrid x:Name="dgEvents" Grid.Row="2" Margin="15,5" MouseDoubleClick="dgEvents_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="200"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding EventDate, StringFormat='dd.MM.yyyy'}" Width="100"/>
                <DataGridTextColumn Header="Дорожка" Binding="{Binding Lanes.LaneNumber}" Width="80"/>
                <DataGridTextColumn Header="Участников" Binding="{Binding EventRegistrations.Count}" Width="100"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="15,0,15,10">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="btnAdd" Content="Добавить" Style="{StaticResource BtnMain}" Width="120" Click="btnAdd_Click"/>
                <Button x:Name="btnEdit" Content="Редактировать" Style="{StaticResource BtnMain}" Width="150" Click="btnEdit_Click"/>
                <Button x:Name="btnMembers" Content="Участники" Style="{StaticResource BtnMain}" Width="130" Click="btnMembers_Click"/>
                <Button x:Name="btnDelete" Content="Удалить" Style="{StaticResource BtnMain}" Width="120" Background="#FFB24A3E" Click="btnDelete_Click"/>
                <Button x:Name="btnExport" Content="Экспорт в CSV" Style="{StaticResource BtnMain}" Width="150" Click="btnExport_Click"/>
            </StackPanel>
            <TextBlock x:Name="tbCount" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Page>
