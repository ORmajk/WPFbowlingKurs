<Page x:Class="WPFbowlingKurs.AppData.Pages.AwardsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:WPFbowlingKurs.AppData.Pages"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="1000"
      Title="AwardsPage" IsVisibleChanged="Page_IsVisibleChanged">

    <Grid Background="{StaticResource BackColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource HeaderColor}">
            <TextBlock Text="Награды и баллы" FontSize="22" Margin="30,0,0,0" Foreground="#FF4E5E38"/>
            <Button x:Name="btnBack" Content="Назад" Style="{StaticResource BtnMain}" Width="100" HorizontalAlignment="Right"
                    Margin="0,0,20,0" Click="btnBack_Click"/>
        </Grid>

        <TabControl Grid.Row="1" Margin="15,10" FontFamily="Verdana" FontSize="14">
            <TabItem Header="Выданные награды">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="5">
                        <TextBlock Text="Пользователь:" Margin="5"/>
                        <ComboBox x:Name="cbUser" Width="260" DisplayMemberPath="FullName"/>
                        <TextBlock Text="Награда:" Margin="10,5,5,5"/>
                        <ComboBox x:Name="cbAward" Width="220" DisplayMemberPath="Name"/>
                        <Button x:Name="btnGive" Content="Выдать награду" Style="{StaticResource BtnMain}" Width="170" Click="btnGive_Click"/>
                    </WrapPanel>
                    <DataGrid x:Name="dgUserAwards" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Пользователь" Binding="{Binding Users.FullName}" Width="*"/>
                            <DataGridTextColumn Header="Роль" Binding="{Binding Users.Role}" Width="100"/>
                            <DataGridTextColumn Header="Награда" Binding="{Binding Awards.Name}" Width="200"/>
                            <DataGridTextColumn Header="Дата" Binding="{Binding AwardedAt, StringFormat='dd.MM.yyyy HH:mm'}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button x:Name="btnTake" Grid.Row="2" Content="Забрать награду" Style="{StaticResource BtnMain}" Width="180"
                            HorizontalAlignment="Left" Background="#FFB24A3E" Click="btnTake_Click"/>
                </Grid>
            </TabItem>

            <TabItem Header="Рейтинг по баллам">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="dgRating">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                            <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="140"/>
                            <DataGridTextColumn Header="Роль" Binding="{Binding Role}" Width="100"/>
                            <DataGridTextColumn Header="Баллы" Binding="{Binding Points}" Width="90"/>
                            <DataGridTextColumn Header="Наград" Binding="{Binding UserAwards.Count}" Width="90"/>
                            <DataGridCheckBoxColumn Header="AI" Binding="{Binding IsSubscribedToAI}" Width="50"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button x:Name="btnExport" Grid.Row="1" Content="Экспорт в CSV" Style="{StaticResource BtnMain}" Width="160"
                            HorizontalAlignment="Left" Click="btnExport_Click"/>
                </Grid>
            </TabItem>

            <TabItem Header="Список наград">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="dgAwards">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="220"/>
                            <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="Выдано" Binding="{Binding UserAwards.Count}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="tbRules" Grid.Row="1" Margin="5" FontSize="12" TextWrapping="Wrap"/>
                    <WrapPanel Grid.Row="2" Margin="0,5">
                        <TextBlock Text="Название:" Margin="5"/>
                        <TextBox x:Name="tbAwardName" Width="200"/>
                        <TextBlock Text="Описание:" Margin="5"/>
                        <TextBox x:Name="tbAwardDescription" Width="280"/>
                        <Button x:Name="btnAddAward" Content="Добавить" Style="{StaticResource BtnMain}" Width="120" Click="btnAddAward_Click"/>
                        <Button x:Name="btnDeleteAward" Content="Удалить" Style="{StaticResource BtnMain}" Width="110"
                                Background="#FFB24A3E" Click="btnDeleteAward_Click"/>
                    </WrapPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
