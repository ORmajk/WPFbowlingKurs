<Page x:Class="WPFbowlingKurs.AppData.Pages.RegistrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:WPFbowlingKurs.AppData.Pages"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="1000"
      Title="RegistrationPage">

    <Grid Background="{StaticResource MainColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource HeaderColor}">
            <TextBlock Text="Регистрация клиента" FontSize="22" Margin="30,0,0,0" Foreground="#FF4E5E38"/>
            <Button x:Name="btnBack" Content="Назад" Style="{StaticResource BtnMain}" Width="100" HorizontalAlignment="Right"
                    Margin="0,0,20,0" Click="btnBack_Click"/>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource TextColor}" CornerRadius="10" Width="520"
                HorizontalAlignment="Center" VerticalAlignment="Center" Padding="25,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="55"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Новый клиент" FontSize="18" Grid.ColumnSpan="2" HorizontalAlignment="Center"/>

                <TextBlock Text="ФИО:" Grid.Row="1"/>
                <TextBox x:Name="tbFullName" Grid.Row="1" Grid.Column="1"/>

                <TextBlock Text="Телефон:" Grid.Row="2"/>
                <TextBox x:Name="tbPhone" Grid.Row="2" Grid.Column="1"/>

                <TextBlock Text="Email:" Grid.Row="3"/>
                <TextBox x:Name="tbEmail" Grid.Row="3" Grid.Column="1"/>

                <TextBlock Text="Логин:" Grid.Row="4"/>
                <TextBox x:Name="tbLogin" Grid.Row="4" Grid.Column="1"/>

                <TextBlock Text="Пароль:" Grid.Row="5"/>
                <PasswordBox x:Name="pbPassword" Grid.Row="5" Grid.Column="1"/>

                <TextBlock Text="Повтор пароля:" Grid.Row="6"/>
                <PasswordBox x:Name="pbPassword2" Grid.Row="6" Grid.Column="1"/>

                <TextBlock Grid.Row="7" Grid.ColumnSpan="2" FontSize="12" TextWrapping="Wrap" Margin="5"
                           Text="Пароль - не меньше 6 символов, хотя бы одна цифра. После регистрации вы сможете бронировать дорожки, записываться на мероприятия и копить баллы."/>

                <Button x:Name="btnRegister" Content="Зарегистрироваться" Style="{StaticResource BtnMain}" Grid.Row="8"
                        Grid.ColumnSpan="2" Width="230" Click="btnRegister_Click"/>
            </Grid>
        </Border>
    </Grid>
</Page>
