<Page x:Class="WPFbowlingKurs.AppData.Pages.Authorization"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPFbowlingKurs.AppData.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1000"
      Title="Authorization">

    <Grid Background="{StaticResource MainColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource HeaderColor}">
            <Label x:Name="lblNameClub" Content="Голден Страйк" HorizontalAlignment="Left" Margin="30,0,0,0"
                   VerticalAlignment="Center" FontSize="22" FontFamily="Verdana" Foreground="#FF4E5E38"/>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource TextColor}" CornerRadius="10" Width="400" Height="350"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Margin="30,20">
                <TextBlock Text="Вход в систему" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                <TextBlock Text="Логин" Margin="5,0"/>
                <TextBox x:Name="tbLogin"/>
                <TextBlock Text="Пароль" Margin="5,5,5,0"/>
                <PasswordBox x:Name="pbPassword"/>
                <Button x:Name="btnLogin" Content="Войти" Style="{StaticResource BtnMain}" Margin="5,20,5,5"
                        Click="btnLogin_Click"/>
                <Button x:Name="btnRegister" Content="Регистрация клиента" Style="{StaticResource BtnMain}"
                        Background="{StaticResource MainColor}" Click="btnRegister_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
