<Page x:Class="WPFbowlingKurs.AppData.Pages.ClientBookingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:WPFbowlingKurs.AppData.Pages"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="1000"
      Title="ClientBookingPage">

    <Grid Background="{StaticResource BackColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource HeaderColor}">
            <TextBlock Text="Бронирование дорожки" FontSize="22" Margin="30,0,0,0" Foreground="#FF4E5E38"/>
            <Button x:Name="btnBack" Content="Назад" Style="{StaticResource BtnMain}" Width="100" HorizontalAlignment="Right"
                    Margin="0,0,20,0" Click="btnBack_Click"/>
        </Grid>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource HeaderColor}" BorderThickness="2"
                    CornerRadius="8" Padding="8" VerticalAlignment="Top">
                <StackPanel>
                    <Border Height="150" CornerRadius="5" ClipToBounds="True">
                        <Image x:Name="imgLane" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock x:Name="tbLaneInfo" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Width="520" HorizontalAlignment="Left" Margin="25,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="60"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Text="Дорожка:" Grid.Row="0"/>
                <ComboBox x:Name="cbLane" Grid.Row="0" Grid.Column="1" SelectionChanged="cbLane_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="{Binding LaneNumber, StringFormat='№{0}'}"/>
                                <Run Text="{Binding LaneTypes.Name}"/>
                                <Run Text="{Binding PricePerHour, StringFormat='- {0:N0} руб./час'}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="Дата:" Grid.Row="1"/>
                <DatePicker x:Name="dpDate" Grid.Row="1" Grid.Column="1"/>

                <TextBlock Text="Время начала:" Grid.Row="2"/>
                <ComboBox x:Name="cbTime" Grid.Row="2" Grid.Column="1"/>

                <TextBlock Text="Длительность (мин):" Grid.Row="3"/>
                <ComboBox x:Name="cbDuration" Grid.Row="3" Grid.Column="1" SelectionChanged="cbDuration_SelectionChanged"/>

                <TextBlock Text="Способ оплаты:" Grid.Row="4"/>
                <ComboBox x:Name="cbPayment" Grid.Row="4" Grid.Column="1"/>

                <CheckBox x:Name="chbPoints" Grid.Row="5" Grid.ColumnSpan="2" Checked="chbPoints_Changed" Unchecked="chbPoints_Changed">
                    <TextBlock x:Name="tbPointsText" TextWrapping="Wrap" Width="480"/>
                </CheckBox>

                <TextBlock x:Name="tbTotal" Grid.Row="6" Grid.ColumnSpan="2" FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource ButtonColor}"/>

                <Button x:Name="btnSave" Content="Забронировать" Style="{StaticResource BtnMain}" Grid.Row="7" Grid.ColumnSpan="2"
                        Width="220" Click="btnSave_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Page>
