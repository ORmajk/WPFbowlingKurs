<Page x:Class="WPFbowlingKurs.AppData.Pages.LanesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPFbowlingKurs.AppData.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1000"
      Title="LanesPage" IsVisibleChanged="Page_IsVisibleChanged">

    <Grid Background="{StaticResource BackColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource HeaderColor}">
            <TextBlock Text="Дорожки" FontSize="22" Margin="30,0,0,0" Foreground="#FF4E5E38"/>
            <Button x:Name="btnBack" Content="Назад" Style="{StaticResource BtnMain}" Width="100" HorizontalAlignment="Right"
                    Margin="0,0,20,0" Click="btnBack_Click"/>
        </Grid>

        <WrapPanel Grid.Row="1" Margin="10,5">
            <TextBlock Text="Поиск по номеру:" Margin="5"/>
            <TextBox x:Name="tbSearch" Width="120" TextChanged="tbSearch_TextChanged"/>
            <TextBlock Text="Категория:" Margin="10,5,5,5"/>
            <ComboBox x:Name="cbType" Width="150" DisplayMemberPath="Name" SelectionChanged="cbType_SelectionChanged"/>
            <TextBlock Text="Состояние:" Margin="10,5,5,5"/>
            <ComboBox x:Name="cbStatus" Width="200" DisplayMemberPath="Name" SelectionChanged="cbStatus_SelectionChanged"/>
            <TextBlock Text="Сортировка:" Margin="10,5,5,5"/>
            <ComboBox x:Name="cbSort" Width="200" SelectionChanged="cbSort_SelectionChanged">
                <ComboBoxItem Content="По номеру"/>
                <ComboBoxItem Content="Цена по возрастанию"/>
                <ComboBoxItem Content="Цена по убыванию"/>
                <ComboBoxItem Content="По вместимости"/>
            </ComboBox>
        </WrapPanel>

        <ListView x:Name="lvLanes" Grid.Row="2" Margin="15,5" Background="Transparent" BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="lvLanes_MouseDoubleClick">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Width="230" Background="White" BorderBrush="{StaticResource HeaderColor}" BorderThickness="2"
                            CornerRadius="8" Padding="8" Margin="3">
                        <StackPanel>
                            <Border Height="130" CornerRadius="5" ClipToBounds="True">
                                <Image Source="{Binding PhotoPath}" Stretch="UniformToFill"/>
                            </Border>
                            <TextBlock Text="{Binding LaneNumber, StringFormat='Дорожка №{0}'}" FontSize="16" FontWeight="Bold"
                                       Foreground="#FF4E5E38" Margin="0,6,0,2"/>
                            <TextBlock Text="{Binding LaneTypes.Name}" FontSize="13"/>
                            <TextBlock Text="{Binding Capacity, StringFormat='Вместимость: {0} чел.'}" FontSize="13"/>
                            <TextBlock Text="{Binding PricePerHour, StringFormat='{}{0:N0} руб./час'}" FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource ButtonColor}" Margin="0,3"/>
                            <TextBlock Text="{Binding LaneStatuses.Name}" FontSize="13" FontWeight="Bold"
                                       Foreground="{Binding LaneStatuses.Color}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="3" Margin="15,0,15,10">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="btnAdd" Content="Добавить" Style="{StaticResource BtnMain}" Width="130" Click="btnAdd_Click"/>
                <Button x:Name="btnEdit" Content="Редактировать" Style="{StaticResource BtnMain}" Width="150" Click="btnEdit_Click"/>
                <Button x:Name="btnDelete" Content="Удалить" Style="{StaticResource BtnMain}" Width="130" Background="#FFB24A3E" Click="btnDelete_Click"/>
                <Button x:Name="btnBook" Content="Забронировать" Style="{StaticResource BtnMain}" Width="170" Visibility="Collapsed" Click="btnBook_Click"/>
                <Button x:Name="btnExport" Content="Экспорт в CSV" Style="{StaticResource BtnMain}" Width="150" Click="btnExport_Click"/>
            </StackPanel>
            <TextBlock x:Name="tbCount" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Page>
