<Page x:Class="WPFbowlingKurs.AppData.Pages.InventoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPFbowlingKurs.AppData.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1000"
      Title="InventoryPage" IsVisibleChanged="Page_IsVisibleChanged">

    <Grid Background="{StaticResource BackColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource HeaderColor}">
            <TextBlock Text="Инвентарь" FontSize="22" Margin="30,0,0,0" Foreground="#FF4E5E38"/>
            <Button x:Name="btnBack" Content="Назад" Style="{StaticResource BtnMain}" Width="100" HorizontalAlignment="Right"
                    Margin="0,0,20,0" Click="btnBack_Click"/>
        </Grid>

        <WrapPanel Grid.Row="1" Margin="10,5">
            <TextBlock Text="Поиск по названию:" Margin="5"/>
            <TextBox x:Name="tbSearch" Width="200" TextChanged="tbSearch_TextChanged"/>
            <TextBlock Text="Статус:" Margin="10,5,5,5"/>
            <ComboBox x:Name="cbStatus" Width="180" DisplayMemberPath="Name" SelectionChanged="cbStatus_SelectionChanged"/>
        </WrapPanel>

        <DataGrid x:Name="dgInventory" Grid.Row="2" Margin="15,5">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="120"/>
                <DataGridTextColumn Header="Размер / вес" Binding="{Binding SizeOrWeight}" Width="130"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding InventoryStatuses.Name}" Width="160"/>
                <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="110"/>
                <DataGridTextColumn Header="Добавлен" Binding="{Binding CreatedAt, StringFormat='dd.MM.yyyy'}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="15,0,15,10">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="btnAdd" Content="Добавить" Style="{StaticResource BtnMain}" Width="120" Click="btnAdd_Click"/>
                <Button x:Name="btnEdit" Content="Редактировать" Style="{StaticResource BtnMain}" Width="150" Click="btnEdit_Click"/>
                <Button x:Name="btnDelete" Content="Удалить" Style="{StaticResource BtnMain}" Width="110" Background="#FFB24A3E" Click="btnDelete_Click"/>
                <Button x:Name="btnGive" Content="Выдать 1 шт." Style="{StaticResource BtnMain}" Width="140" Click="btnGive_Click"/>
                <Button x:Name="btnReturn" Content="Вернуть 1 шт." Style="{StaticResource BtnMain}" Width="140" Click="btnReturn_Click"/>
            </StackPanel>
            <TextBlock x:Name="tbCount" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Page>
