<Page x:Class="WPFbowlingKurs.AppData.Pages.AddEditInventoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPFbowlingKurs.AppData.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1000"
      Title="AddEditInventoryPage">

    <Grid Background="{StaticResource BackColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource HeaderColor}">
            <TextBlock x:Name="tbTitle" Text="Добавление инвентаря" FontSize="22" Margin="30,0,0,0" Foreground="#FF4E5E38"/>
            <Button x:Name="btnBack" Content="Назад" Style="{StaticResource BtnMain}" Width="100" HorizontalAlignment="Right"
                    Margin="0,0,20,0" Click="btnBack_Click"/>
        </Grid>

        <Grid Grid.Row="1" Width="500" HorizontalAlignment="Center" Margin="0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="60"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Text="Название:" Grid.Row="0"/>
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name}"/>

            <TextBlock Text="Тип:" Grid.Row="1"/>
            <ComboBox x:Name="cbType" Grid.Row="1" Grid.Column="1" SelectedItem="{Binding Type}"/>

            <TextBlock Text="Размер / вес:" Grid.Row="2"/>
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SizeOrWeight}"/>

            <TextBlock Text="Статус:" Grid.Row="3"/>
            <ComboBox x:Name="cbStatus" Grid.Row="3" Grid.Column="1" DisplayMemberPath="Name" SelectedItem="{Binding InventoryStatuses}"/>

            <TextBlock Text="Количество:" Grid.Row="4"/>
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Quantity}"/>

            <Button x:Name="btnSave" Content="Сохранить" Style="{StaticResource BtnMain}" Grid.Row="5" Grid.ColumnSpan="2"
                    Width="200" Click="btnSave_Click"/>
        </Grid>
    </Grid>
</Page>
