<Page x:Class="WPFbowlingKurs.AppData.Pages.ClientsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPFbowlingKurs.AppData.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1000"
      Title="ClientsPage" IsVisibleChanged="Page_IsVisibleChanged">

    <Grid Background="{StaticResource BackColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource HeaderColor}">
            <TextBlock Text="Клиенты" FontSize="22" Margin="30,0,0,0" Foreground="#FF4E5E38"/>
            <Button x:Name="btnBack" Content="Назад" Style="{StaticResource BtnMain}" Width="100" HorizontalAlignment="Right"
                    Margin="0,0,20,0" Click="btnBack_Click"/>
        </Grid>

        <WrapPanel Grid.Row="1" Margin="10,5">
            <TextBlock Text="Поиск (ФИО, телефон, email):" Margin="5"/>
            <TextBox x:Name="tbSearch" Width="280" TextChanged="tbSearch_TextChanged"/>
        </WrapPanel>

        <DataGrid x:Name="dgClients" Grid.Row="2" Margin="15,5">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="160"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                <DataGridTextColumn Header="Дата рег." Binding="{Binding RegistrationDate, StringFormat='dd.MM.yyyy'}" Width="100"/>
                <DataGridTextColumn Header="Баллы" Binding="{Binding Points}" Width="70"/>
                <DataGridCheckBoxColumn Header="Подписка" Binding="{Binding IsSubscribedToAl}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="15,0,15,10">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="btnAdd" Content="Добавить" Style="{StaticResource BtnMain}" Width="130" Click="btnAdd_Click"/>
                <Button x:Name="btnEdit" Content="Редактировать" Style="{StaticResource BtnMain}" Width="150" Click="btnEdit_Click"/>
                <Button x:Name="btnDelete" Content="Удалить" Style="{StaticResource BtnMain}" Width="130" Background="#FFB24A3E" Click="btnDelete_Click"/>
            </StackPanel>
            <TextBlock x:Name="tbCount" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Page>
