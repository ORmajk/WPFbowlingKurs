<Page x:Class="WPFbowlingKurs.AppData.Pages.AddEditUserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPFbowlingKurs.AppData.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1000"
      Title="AddEditUserPage">

    <Grid Background="{StaticResource BackColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource HeaderColor}">
            <TextBlock x:Name="tbTitle" Text="Добавление сотрудника" FontSize="22" Margin="30,0,0,0" Foreground="#FF4E5E38"/>
            <Button x:Name="btnBack" Content="Назад" Style="{StaticResource BtnMain}" Width="100" HorizontalAlignment="Right"
                    Margin="0,0,20,0" Click="btnBack_Click"/>
        </Grid>

        <Grid Grid.Row="1" Width="500" HorizontalAlignment="Center" Margin="0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="60"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Text="ФИО:" Grid.Row="0"/>
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding FullName}"/>

            <TextBlock Text="Логин:" Grid.Row="1"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Login}"/>

            <TextBlock Text="Пароль:" Grid.Row="2"/>
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Password}"/>

            <TextBlock Text="Роль:" Grid.Row="3"/>
            <ComboBox x:Name="cbRole" Grid.Row="3" Grid.Column="1" SelectedItem="{Binding Role}"/>

            <TextBlock Text="Телефон:" Grid.Row="4"/>
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Phone}"/>

            <TextBlock Text="Email:" Grid.Row="5"/>
            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Email}"/>

            <TextBlock Text="Баллы:" Grid.Row="6"/>
            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Points}"/>

            <Button x:Name="btnSave" Content="Сохранить" Style="{StaticResource BtnMain}" Grid.Row="7" Grid.ColumnSpan="2"
                    Width="200" Click="btnSave_Click"/>
        </Grid>
    </Grid>
</Page>
